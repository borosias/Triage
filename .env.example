# Supabase transaction pooler URL for the serverless application runtime.
DATABASE_URL=

# At least 32 characters. Used only on the server to sign local login sessions.
SESSION_SECRET=

# At least 32 characters. Shared only by Supabase Database Webhooks and the
# internal notification worker; never expose it to the browser.
NOTIFICATION_WEBHOOK_SECRET=

# Supabase direct URL for Prisma migrations. Use the session pooler when the
# direct IPv6 endpoint is unavailable from the development environment.
DIRECT_URL=
